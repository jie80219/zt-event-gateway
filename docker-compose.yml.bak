name: zt-event-gateway
services:

  # ── Infrastructure ──────────────────────────────────────────────

  rabbitmq:
    image: rabbitmq:3.13-management
    container_name: zt-rabbitmq
    ports:
      - "5672:5672"
      - "15672:15672"
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
      - ./docker/rabbitmq/rabbitmq.conf:/etc/rabbitmq/rabbitmq.conf:ro
      - ./docker/rabbitmq/definitions.json:/etc/rabbitmq/definitions.json:ro
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 5s
      timeout: 3s
      retries: 20
    networks:
      - anser_project_network

  eventstoredb:
    container_name: eventstoredb
    image: eventstore/eventstore:latest
    environment:
        EVENTSTORE_CLUSTER_SIZE: 1
        EVENTSTORE_RUN_PROJECTIONS: All
        EVENTSTORE_START_STANDARD_PROJECTIONS: "true"
        EVENTSTORE_INSECURE: "true"
        EVENTSTORE_ENABLE_ATOM_PUB_OVER_HTTP: "true"
    ports:
        - '1113:1113' # TCP 客戶端通信
        - '2113:2113' # HTTP API 接口
    networks:
        - anser_project_network

  # ── SPIFFE / SPIRE ──────────────────────────────────────────────

  spire-server:
    image: ghcr.io/spiffe/spire-server:1.12.0
    container_name: zt-spire-server
    command:
      - -config
      - /opt/spire/conf/server/server.conf
    volumes:
      - ./spiffe/spire-server-e2e/server.conf:/opt/spire/conf/server/server.conf:ro
      - ./spiffe/certs/agent-ca.crt.pem:/opt/spire/conf/server/agent-ca.crt.pem:ro
    healthcheck:
      test: ["CMD", "/opt/spire/bin/spire-server", "healthcheck"]
      interval: 5s
      timeout: 3s
      retries: 30
      start_period: 10s
    networks:
      - anser_project_network

  spire-agent:
    image: ghcr.io/spiffe/spire-agent:1.12.0
    container_name: zt-spire-agent
    command:
      - -config
      - /opt/spire/conf/agent/agent.conf
    depends_on:
      spire-server:
        condition: service_healthy
    volumes:
      - ./spiffe/spire-agent-e2e/agent.conf:/opt/spire/conf/agent/agent.conf:ro
      - ./spiffe/certs/agent.key.pem:/opt/spire/conf/agent/agent.key.pem:ro
      - ./spiffe/certs/agent.crt.pem:/opt/spire/conf/agent/agent.crt.pem:ro
      - spire-agent-sockets:/run/spire/sockets
    healthcheck:
      test: ["CMD", "/opt/spire/bin/spire-agent", "healthcheck", "-socketPath", "/run/spire/sockets/agent.sock"]
      interval: 5s
      timeout: 3s
      retries: 30
      start_period: 15s
    networks:
      - anser_project_network

  # ── Application (OpenSwoole) ────────────────────────────────────

  spiffe-watcher:
    pid: "service:spire-agent"
    build:
      context: .
      dockerfile: docker/php-openswoole/Dockerfile
    container_name: zt-spiffe-watcher
    command: ["php", "bin/spiffe-watcher.php"]
    environment:
      SPIFFE_ENDPOINT_SOCKET: "unix:/run/spire/sockets/agent.sock"
      SPIFFE_PEM_DIR: "/tmp/spiffe-certs"
      SPIFFE_SHM_DIR: "/tmp/spiffe-shared"
      SPIFFE_WATCHER_HEALTH_ADDR: "0.0.0.0:9901"
    volumes:
      - spire-agent-sockets:/run/spire/sockets:ro
      - spiffe-certs:/tmp/spiffe-certs
      - spiffe-shared:/tmp/spiffe-shared
    depends_on:
      spire-agent:
        condition: service_healthy
    healthcheck:
      # Check SHM state directly — avoids depending on the coroutine HTTP
      # endpoint which isn't available in every OpenSwoole flavor.
      test: ["CMD-SHELL", "php -r 'exit((json_decode(@file_get_contents(\"/tmp/spiffe-shared/meta.json\"),true)[\"x509_state\"]??\"\")===\"ready\"?0:1);'"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 15s
    networks:
      - anser_project_network

  gateway:
    pid: "service:spire-agent"
    build:
      context: .
      dockerfile: docker/php-openswoole/Dockerfile
    container_name: zt-gateway
    command: ["php", "bin/gateway.php"]
    environment:
      GATEWAY_HOST: "0.0.0.0"
      GATEWAY_PORT: "8080"
      GATEWAY_WORKERS: "2"
      RABBITMQ_HOST: "rabbitmq"
      RABBITMQ_PORT: "5672"
      RABBITMQ_USER: "zt"
      RABBITMQ_PASS: "ztpass"
      EVENTSTOREDB_HOST: eventstoredb
      EVENTSTOREDB_PORT: 2113
      SPIFFE_ID: "spiffe://zt.local/php-gateway"
      SPIFFE_ENDPOINT_SOCKET: "unix:/run/spire/sockets/agent.sock"
      SPIFFE_PEM_DIR: "/tmp/spiffe-certs"
      SPIFFE_SHM_DIR: "/tmp/spiffe-shared"
      WORKER_SPIFFE_ID: "spiffe://zt.local/php-worker"
      SPIFFE_TRUST_DOMAIN: "zt.local"
      LSVID_ENABLED: "1"
      LSVID_REQUIRED: "1"
      LSVID_TTL_SECONDS: "1800"
      LSVID_LOG_PAYLOAD: "0"
    volumes:
      - spire-agent-sockets:/run/spire/sockets:ro
      - spiffe-certs:/tmp/spiffe-certs:ro
      - spiffe-shared:/tmp/spiffe-shared:ro
    ports:
      - "8080:8080"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      rabbitmq:
        condition: service_healthy
      spire-agent:
        condition: service_healthy
      eventstoredb:
        condition: service_healthy
      spiffe-watcher:
        condition: service_healthy
    networks:
      - anser_project_network

  php-worker:
    pid: "service:spire-agent"
    build:
      context: .
      dockerfile: docker/php-openswoole/Dockerfile
    container_name: zt-php-worker
    command: ["php", "bin/worker.php"]
    environment:
      APP_SERVICE_NAME: php-worker
      AMQP_HOST: "rabbitmq"
      AMQP_PORT: "5672"
      AMQP_USER: "zt"
      AMQP_PASSWORD: "ztpass"
      RABBITMQ_HOST: "rabbitmq"
      RABBITMQ_PORT: "5672"
      RABBITMQ_USER: "zt"
      RABBITMQ_PASS: "ztpass"
      SPIFFE_ID: "spiffe://zt.local/php-worker"
      SPIFFE_ENDPOINT_SOCKET: "unix:/run/spire/sockets/agent.sock"
      SPIFFE_PEM_DIR: "/tmp/spiffe-certs"
      SPIFFE_SHM_DIR: "/tmp/spiffe-shared"
      DOWNSTREAM_SPIFFE_ID: "spiffe://zt.local/php-worker"
      SPIFFE_TRUST_DOMAIN: "zt.local"
      LSVID_ENABLED: "1"
      LSVID_REQUIRED: "1"
      LSVID_TTL_SECONDS: "1800"
      LSVID_LOG_PAYLOAD: "0"
      # ── mTLS to downstream services ──
      SPIFFE_MTLS_ENABLED: "0"
      ORDER_SERVICE_HOST: "host.docker.internal"
      ORDER_SERVICE_PORT: "8082"
      PRODUCTION_SERVICE_HOST: "host.docker.internal"
      PRODUCTION_SERVICE_PORT: "8083"
      USER_SERVICE_HOST: "host.docker.internal"
      USER_SERVICE_PORT: "8084"
      ORDER_SPIFFE_ID: "spiffe://zt.local/order-service"
      PRODUCTION_SPIFFE_ID: "spiffe://zt.local/production-service"
      USER_SPIFFE_ID: "spiffe://zt.local/user-service"
      # ── EventStoreDB ──
      EVENTSTOREDB_ENABLED: "1"
      EVENTSTOREDB_HOST: "eventstoredb"
      EVENTSTOREDB_PORT: "2113"
    volumes:
      - spire-agent-sockets:/run/spire/sockets:ro
      - spiffe-certs:/tmp/spiffe-certs:ro
      - spiffe-shared:/tmp/spiffe-shared:ro
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      rabbitmq:
        condition: service_healthy
      spire-agent:
        condition: service_healthy
      eventstoredb:
        condition: service_healthy
      spiffe-watcher:
        condition: service_healthy
    networks:
      - anser_project_network

volumes:
  rabbitmq_data:
  eventstoredb_data:
  spire-agent-sockets:
  spiffe-certs:
  spiffe-shared:

networks:
  anser_project_network:
    external: true
