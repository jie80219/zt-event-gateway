graph LR
    %% 定義樣式
    classDef client fill:#f9f9f9,stroke:#333,stroke-width:2px;
    classDef gateway fill:#e1f5fe,stroke:#0277bd,stroke-width:2px;
    classDef queue fill:#fff3e0,stroke:#e65100,stroke-width:2px;
    classDef consumer fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px;
    classDef saga fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px;
    classDef endstate fill:#ffebee,stroke:#c62828,stroke-width:2px;

    %% 節點定義
    Client([HTTP Client]):::client
    Gateway["Gateway<br/>(正規化 + CloudEvents 封裝 + SPIFFE ID)"]:::gateway
    OrderQueue[("RabbitMQ<br/>order_queue")]:::queue
    ReqConsumer["RequestConsumer<br/>(驗證信封 + SPIFFE 驗證)"]:::consumer
    EventQueue[("Event Queues<br/>(OrderCreateRequestedEvent, ...)")]:::queue
    EvtConsumer["EventConsumer<br/>(SPIFFE 驗證 + 分派)"]:::consumer
    Saga{"OrderSaga<br/>(執行業務 + 發布下一個事件)"}:::saga
    EndState([Saga 完成 / 觸發補償]):::endstate

    %% 流程定義
    Client --> Gateway
    Gateway --> OrderQueue
    OrderQueue --> ReqConsumer
    ReqConsumer --> EventQueue
    EventQueue --> EvtConsumer
    EvtConsumer --> Saga
    Saga -- 發布下一個事件 --> EventQueue
    Saga -- 循環結束 --> EndState
