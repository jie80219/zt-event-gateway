gatewayregister.address = 'anser-gateway'
# gatewayregister.interval = '60s'
# gatewayregister.timeout = '5s'
gatewayregister.healthRoute = 'api/health'

#--------------------------------------------------------------------
# Service Discovery
#--------------------------------------------------------------------
servicediscovery.defaultServiceGroup = AnserGateway
# servicediscovery.address = ''
servicediscovery.scheme  = 'http'
# servicediscovery.dataCenter = ''                                  # [optional]
# servicediscovery.reloadTime = 300                                 # [optional] php json encode opt value to use when serializing requests

#--------------------------------------------------------------------
# Entropy Load Balance
#--------------------------------------------------------------------
LOAD_BALANCE_METRICS_PATTERN = metrics:*
LOAD_BALANCE_SCORE_KEY = metrics:anser-gateway
# LOAD_BALANCE_SCORE_ALIAS = 10.1.1.91=production-1,10.1.1.92=production-2
LOAD_BALANCE_CACHE_SYNC_INTERVAL = 5
LOAD_BALANCE_MONITOR_INTERVAL = 5
LOAD_BALANCE_STD_THRESHOLD = 0.8
LOAD_BALANCE_RECALC_QUEUE = recalc_weight
LOAD_BALANCE_AMQP_HOST = rabbitmq
LOAD_BALANCE_AMQP_PORT = 5672
LOAD_BALANCE_AMQP_USER = zt
LOAD_BALANCE_AMQP_PASSWORD = ztpass
