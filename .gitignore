/vendor/
/.idea/
/.vscode/
/.phpunit.result.cache
/.swow
/swow/
/.env
/.env.local
/artifacts/

# Paper-5 attack capture pcaps — may contain TLS ciphertext from live runs.
artifacts/sec-*/pcap/
artifacts/sec-*/**/*.pcap

# Thesis-related artifacts — raw data files and draft chapters are not
# tracked (regeneratable via scripts/run-thesis-experiment.sh).
# Previously tracked files remain tracked; new files are ignored.
/docs/data/
/docs/*
!/docs/thesis/
/docs/thesis/*
!/docs/thesis/ch2.5-shm-svid-delivery.md
!/docs/thesis/4.md
# Experiment goal/plan specs are tracked (goal.md, goal2*.md, …).
!/docs/goal/
/.lsvid-experiment.override.yml

.claude/
.claude-logs/
.phpunit.cache/

# Symlinked external packages
packages/php-lsvid/

# Local Vault sandbox produced by docker compose (creds, file, logs)
docker/vault/

# Vault-PKI AppRole creds (role_id/secret_id) — secrets, never commit
docker/vault-pki/creds/

# Python bytecode cache (analyzer scripts)
scripts/experiments/__pycache__/
