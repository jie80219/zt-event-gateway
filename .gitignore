.phpunit.cache/

# Symlinked external packages
packages/php-lsvid/

# Linkerd 1.x mesh — keep cert *public* parts, never commit private keys.
docker/linkerd/tls/ca/ca.key
docker/linkerd/tls/certs/*.key
docker/linkerd/tls/host-*.key
