/vendor/
/.idea/
/.vscode/
/.phpunit.result.cache
/.swow
/swow/
/.env
/.env.local
/artifacts/

# Thesis-related artifacts — raw data files and draft chapters are not
# tracked (regeneratable via scripts/run-thesis-experiment.sh).
# Previously tracked files remain tracked; new files are ignored.
/docs/data/
/docs/*
!/docs/thesis/
/docs/thesis/*
!/docs/thesis/ch2.5-shm-svid-delivery.md
!/docs/thesis/4.md
!/docs/linkerd-flow.md

.claude/
.claude-logs/
.phpunit.cache/

# Linkerd 1.x mesh — generated per host via gen-certs.sh, never tracked.
docker/linkerd/tls/*
!docker/linkerd/tls/gen-certs.sh

# Python bytecode / packaging artifacts
__pycache__/
*.py[cod]
*.egg-info/
