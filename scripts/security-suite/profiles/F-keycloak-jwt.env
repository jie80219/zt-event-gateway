# Profile F — Real Keycloak realm + downstream Service JWT validation
#
# Sourced by scripts/security-suite/run-security-suite.sh when SEC_PROFILES
# includes "F-keycloak-jwt". The fair counterpart of C-lsvid-only on the
# OAuth2 side: gateway mints + propagates Bearer, every downstream service
# (Order/Production/User) validates the JWT against Keycloak JWKS.
#
# Differs from E-oauth2-bearer:
#   - Uses real Keycloak realm `zt` with RS256 (not static HS256)
#   - Downstream services validate the Bearer token (defense-in-depth)
#   - keycloak-watcher daemon fetches client_credentials token + JWKS

# Disable the SPIFFE/LSVID stack — Keycloak is the sole identity layer.
SPIFFE_ENABLED=0
LSVID_ENABLED=0
LSVID_REQUIRED=0
SPIFFE_MTLS_ENABLED=0

# Enable Keycloak end-to-end. KEYCLOAK_ENABLED=1 must also reach the three
# downstream Service containers (their docker-compose.yml uses
# ${KEYCLOAK_ENABLED:-0} env substitution).
KEYCLOAK_ENABLED=1
KEYCLOAK_REQUIRED=1
KEYCLOAK_REALM=zt
KEYCLOAK_ISSUER=http://keycloak:8080/realms/zt
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/zt/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=gateway
KEYCLOAK_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET:-}

# Each downstream service's audience matches its Keycloak client_id.
# Exported so a profile-aware orchestrator can fan these out per container.
ORDER_KEYCLOAK_AUDIENCE=order-service
PRODUCTION_KEYCLOAK_AUDIENCE=production-service
USER_KEYCLOAK_AUDIENCE=user-service

# Keycloak compose profile must be active (brings up keycloak, keycloak-db,
# keycloak-watcher). Stays in sync with docker-compose.yml's profile gating.
SEC_COMPOSE_PROFILES=keycloak
