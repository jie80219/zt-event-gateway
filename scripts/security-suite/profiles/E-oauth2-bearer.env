# Profile E — OAuth 2.0 Bearer + Static JWT (non-workload-identity ZT baseline)
#
# Sourced by scripts/security-suite/run-security-suite.sh when SEC_PROFILES
# includes "E-oauth2-bearer". See docs/experiment-comparison-targets.md §2.6
# for the design rationale.

# Kill every SPIFFE-layer defence on the application side. Gateway becomes a
# plain bearer-JWT validator; worker stops validating LSVID at all (mirroring
# how traditional bearer-token ZT architectures terminate trust at the API
# gateway and have no defence-in-depth on the async bus).
SPIFFE_ENABLED=0
LSVID_ENABLED=0
LSVID_REQUIRED=0
SPIFFE_MTLS_ENABLED=0

# JWT gateway configuration — consumed by docker/php-oauth2-gateway/jwt-gateway.php.
# Dev-only key. docker-compose.profile-e.yml ships the same value; keep them
# in sync if you change either.
PROFILE_E_JWT_HS256_KEY=profile-e-dev-only-DO-NOT-USE-IN-PROD-abcdef0123456789
PROFILE_E_JWT_ISSUER=https://idp.example.test
PROFILE_E_JWT_AUDIENCE=zt-event-gateway

# Which compose override to merge in. run-security-suite.sh passes this as
# `-f` to docker compose for Profile E only.
SEC_COMPOSE_OVERRIDE=docker-compose.profile-e.yml
