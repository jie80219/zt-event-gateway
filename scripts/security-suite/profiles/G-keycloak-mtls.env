# Profile G — Real Keycloak realm + downstream JWT validation + SPIFFE mTLS
#
# Hybrid profile: OAuth2 Bearer for application-layer identity + SPIFFE mTLS
# for transport-layer mutual authentication. The fair counterpart of
# D-full-zt on the OAuth2 side, useful for arguing that Keycloak users can
# adopt mTLS to close some of LSVID's defense gaps without giving up JWT.
#
# This is the strongest OAuth2 profile in the matrix — anything weaker is
# a pure-Keycloak deployment.

# Keep SPIFFE plane up (for X.509-SVID + mTLS) but disable LSVID — the chain
# delegation story is replaced by Keycloak Bearer propagation.
SPIFFE_ENABLED=1
LSVID_ENABLED=0
LSVID_REQUIRED=0
SPIFFE_MTLS_ENABLED=1

# Keycloak end-to-end (same as Profile F).
KEYCLOAK_ENABLED=1
KEYCLOAK_REQUIRED=1
KEYCLOAK_REALM=zt
KEYCLOAK_ISSUER=http://keycloak:8080/realms/zt
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/zt/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=gateway
KEYCLOAK_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET:-}

ORDER_KEYCLOAK_AUDIENCE=order-service
PRODUCTION_KEYCLOAK_AUDIENCE=production-service
USER_KEYCLOAK_AUDIENCE=user-service

# Both compose profiles needed: SPIRE stack + Keycloak stack.
SEC_COMPOSE_PROFILES=zt,keycloak
