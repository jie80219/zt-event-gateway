# Arm F — Keycloak Bearer JWT (RS256)
# Branch: feat/keycloak (manual switch required before running this arm).
ARM_LABEL="F-keycloak-jwt"
ARM_BRANCH="feat/keycloak"
ARM_DESC="Keycloak realm zt — RS256 Bearer token, JWKS-validated downstream"

SPIFFE_ENABLED=0
LSVID_ENABLED=0
LSVID_REQUIRED=0
SPIFFE_MTLS_ENABLED=0
KEYCLOAK_ENABLED=1
KEYCLOAK_REQUIRED=1

# Compose profile defined on feat/keycloak — brings up keycloak + keycloak-db
ARM_COMPOSE_PROFILE="keycloak"

# zt-cost-matrix on feat/keycloak should already define this label;
# on feat/spiffe this arm is a no-op (run-3arm-experiment.sh aborts early).
ZT_COST_PROFILE="F-keycloak-jwt"
SEC_PROFILE="F-keycloak-jwt"
