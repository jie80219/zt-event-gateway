# Arm A — baseline (no identity layer)
# Sourced by scripts/run-3arm-experiment.sh and storage.sh.
# Branch: feat/spiffe (with SPIFFE_ENABLED=0 the SPIRE stack is bypassed).
ARM_LABEL="A-baseline"
ARM_BRANCH="feat/spiffe"
ARM_DESC="No identity layer — pure Saga reference point"

# Behaviour toggles applied to gateway/worker/services
SPIFFE_ENABLED=0
LSVID_ENABLED=0
LSVID_REQUIRED=0
SPIFFE_MTLS_ENABLED=0
KEYCLOAK_ENABLED=0
KEYCLOAK_REQUIRED=0

# Compose profile (zt brings up SPIRE; with SPIFFE_ENABLED=0 it stays idle)
ARM_COMPOSE_PROFILE=""

# Maps to existing zt-cost-matrix profile label so we can reuse its harness
ZT_COST_PROFILE="A-baseline"
SEC_PROFILE="A-baseline"
