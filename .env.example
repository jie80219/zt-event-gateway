# ==============================================================================
# zt-event-gateway — environment variables
# Copy this file to `.env` and adjust for your environment.
# Loaded via vlucas/phpdotenv where applicable; all runtime reads use getenv().
# ==============================================================================

# ------------------------------------------------------------------------------
# Gateway (bin/gateway.php — OpenSwoole HTTP server)
# ------------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_WORKERS=2

# ------------------------------------------------------------------------------
# RabbitMQ — worker.php uses AMQP_*, legacy RabbitMQConnection uses RABBITMQ_*.
# Keep both in sync until the naming is consolidated.
# ------------------------------------------------------------------------------
AMQP_HOST=rabbitmq
AMQP_PORT=5672
AMQP_USER=zt
AMQP_PASSWORD=ztpass
AMQP_EXCHANGE=events
AMQP_EXCHANGE_TYPE=direct
REQUEST_QUEUE=order_queue
REQUEST_ROUTING_KEY=request.new

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=zt
RABBITMQ_PASS=ztpass

# ------------------------------------------------------------------------------
# SPIFFE master toggle
#
# Set to 0 to run the stack without any SPIFFE/SPIRE/LSVID/mTLS layer.
# When SPIFFE_ENABLED=0:
#   - the three sub-flags below are force-disabled in gateway + worker
#   - the SPIRE stack (server/agent/workload-registrar/spiffe-watcher)
#     stays dormant because those services sit behind the compose
#     profile `zt` — activate with `COMPOSE_PROFILES=zt docker compose up`
#
# Ablation combinations (see docs/experiment-comparison-targets.md):
#   Baseline:    SPIFFE_ENABLED=0
#   LSVID only:  SPIFFE_ENABLED=1 LSVID_ENABLED=1 SPIFFE_MTLS_ENABLED=0
#   mTLS only:   SPIFFE_ENABLED=1 LSVID_ENABLED=0 SPIFFE_MTLS_ENABLED=1
#   Full ZT:     SPIFFE_ENABLED=1 LSVID_ENABLED=1 SPIFFE_MTLS_ENABLED=1
# ------------------------------------------------------------------------------
SPIFFE_ENABLED=1

# ------------------------------------------------------------------------------
# SPIFFE / SPIRE identity (trust domain: zt.local)
# SPIFFE_ENDPOINT_SOCKET points at the local SPIRE Agent UDS.
# ------------------------------------------------------------------------------
SPIFFE_ID=spiffe://zt.local/php-gateway
SPIFFE_ENDPOINT_SOCKET=unix:/run/spire/sockets/agent.sock

# ------------------------------------------------------------------------------
# SPIFFE watcher (bin/spiffe-watcher.php) — optional tuning
# ------------------------------------------------------------------------------
# Directory to write rotated SVID PEM files (leave empty to disable PEM output)
SPIFFE_PEM_DIR=
# Max reconnect attempts to SPIRE Agent (0 = unlimited)
SPIFFE_MAX_RETRIES=0
SPIFFE_BACKOFF_INITIAL=1
SPIFFE_BACKOFF_MAX=30
SPIFFE_CONNECT_TIMEOUT=5
# Validate SVIDs on every rotation (1 = on, 0 = off)
SPIFFE_VALIDATE=1

# ------------------------------------------------------------------------------
# EventStoreDB (event persistence — HTTP API)
# ------------------------------------------------------------------------------
EVENTSTOREDB_ENABLED=1
EVENTSTOREDB_HOST=eventstoredb
EVENTSTOREDB_PORT=2113

# ------------------------------------------------------------------------------
# E2E / CI knobs (scripts/e2e-gateway.sh, scripts/ci-verify.sh)
# ------------------------------------------------------------------------------
# requeue | consume
E2E_QUEUE_CHECK_MODE=requeue
# none | full
E2E_DIAG_LEVEL=full
# 1 = keep containers on failure for debugging
E2E_KEEP_ON_FAIL=0
E2E_BUILD_IMAGES=1
E2E_WAIT_TIMEOUT=60
# Number of E2E iterations in `composer ci:verify` (default 20 in script)
E2E_RUNS=1
CI_PREBUILD_IMAGES=1

# ------------------------------------------------------------------------------
# Thesis experiment (scripts/run-thesis-experiment.sh,
#                    scripts/collect-experiment-data.sh Stage 5b)
# LSVID_CAPTURE_DEBUG=1 makes downstream services append each received X-LSVID
# (size + raw token) to /tmp/lsvid-capture.log inside the container. Used only
# during size-measurement probes; leave unset in production.
# ------------------------------------------------------------------------------
LSVID_CAPTURE_DEBUG=0

# ------------------------------------------------------------------------------
# Keycloak (service-to-service — OAuth2 Client Credentials grant)
#
# The watcher (bin/keycloak-watcher.php) keeps the service-account token and
# realm JWKS warm in $KEYCLOAK_SHM_DIR for cross-process reuse. Gateway and
# Worker read from SHM under a seqlock; they fall back to a synchronous
# fetch only on cold start.
#
# KEYCLOAK_ENABLED=0 disables the auth layer entirely (default — keeps the
# baseline SPIFFE/LSVID flow untouched). Set to 1 to enable Keycloak
# alongside or instead of SPIFFE; the two stacks are independent flags.
# ------------------------------------------------------------------------------
KEYCLOAK_ENABLED=0

# Issuer — KEYCLOAK_TOKEN_URI and KEYCLOAK_JWKS_URI are derived from this
# when not set explicitly.
KEYCLOAK_ISSUER=http://keycloak:8080/realms/zt
KEYCLOAK_TOKEN_URI=
KEYCLOAK_JWKS_URI=

# Per-service client credentials (must exist as clients in the realm with
# Client Credentials grant enabled and Service Accounts turned on).
KEYCLOAK_CLIENT_ID=gateway
KEYCLOAK_CLIENT_SECRET=

# Downstream audience mapping — client_ids to request on outgoing tokens.
# Matches the clients seeded by docker/keycloak/realm-zt.json.
KEYCLOAK_AUDIENCE_ORDER=order-service
KEYCLOAK_AUDIENCE_PRODUCTION=production-service
KEYCLOAK_AUDIENCE_USER=user-service

# Token / JWKS cache tuning
KEYCLOAK_SHM_DIR=/tmp/keycloak-shared
KEYCLOAK_TOKEN_REFRESH_SKEW=30
KEYCLOAK_JWKS_REFRESH_INTERVAL=300
KEYCLOAK_STALE_THRESHOLD_SECS=900

# Watcher health endpoint (optional; set empty string to disable)
KEYCLOAK_WATCHER_HEALTH_ADDR=127.0.0.1:9901

# ------------------------------------------------------------------------------
# Keycloak — North/South ingress JWT validation
#
# Behaviour: when on, fail-closed — missing / malformed / unverifiable
# tokens are rejected with 401. KEYCLOAK_ENABLED must also be 1 for the
# validator to be wired (JwtValidatorRegistry is populated by
# KeycloakBootstrap).
#
# Default (when this var is unset / empty): mirror KEYCLOAK_ENABLED. Turning
# on the Keycloak east-west stack now also enables north-south ingress
# validation by default — the safer fail-closed posture for the
# spiffe-keycloak threat model. Explicit override:
#   KEYCLOAK_INGRESS_ENABLED=0  → disable (operator opt-out)
#   KEYCLOAK_INGRESS_ENABLED=1  → force-enable
#
# KEYCLOAK_INGRESS_AUDIENCE: the `aud` claim the Gateway expects on inbound
# tokens. Typical choices:
#   - "gateway"   — tokens minted specifically for this gateway
#   - "account"   — Keycloak's default user-token audience
# Falls back to KEYCLOAK_CLIENT_ID when unset.
#
# KEYCLOAK_INGRESS_SKIP_PATHS: comma-separated list (glob `*` supported) of
# request paths that bypass validation (health probes, etc).
# ------------------------------------------------------------------------------
# KEYCLOAK_INGRESS_ENABLED=         # unset → follow KEYCLOAK_ENABLED
KEYCLOAK_INGRESS_AUDIENCE=gateway
KEYCLOAK_INGRESS_SKIP_PATHS=/api/health,/
