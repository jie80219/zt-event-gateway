# ==============================================================================
# zt-event-gateway — environment variables
# Copy this file to `.env` and adjust for your environment.
# Loaded via vlucas/phpdotenv where applicable; all runtime reads use getenv().
# ==============================================================================

# ------------------------------------------------------------------------------
# Gateway (bin/gateway.php — OpenSwoole HTTP server)
# ------------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_WORKERS=2

# ------------------------------------------------------------------------------
# RabbitMQ — worker.php uses AMQP_*, legacy RabbitMQConnection uses RABBITMQ_*.
# Keep both in sync until the naming is consolidated.
# ------------------------------------------------------------------------------
AMQP_HOST=rabbitmq
AMQP_PORT=5672
AMQP_USER=zt
AMQP_PASSWORD=ztpass
AMQP_EXCHANGE=events
AMQP_EXCHANGE_TYPE=direct
REQUEST_QUEUE=order_queue
REQUEST_ROUTING_KEY=request.new

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=zt
RABBITMQ_PASS=ztpass

# ------------------------------------------------------------------------------
# Keycloak (service-to-service — OAuth2 Client Credentials grant)
#
# The watcher (bin/keycloak-watcher.php) keeps the service-account token and
# realm JWKS warm in $KEYCLOAK_SHM_DIR for cross-process reuse. Gateway and
# Worker read from SHM under a seqlock; they fall back to a synchronous
# fetch only on cold start.
#
# KEYCLOAK_ENABLED=0 disables auth entirely (baseline profile for
# experiments). In that mode: no JWT minting, no JWT validation, no
# AudienceRegistry wiring, no global bearer filter.
# ------------------------------------------------------------------------------
KEYCLOAK_ENABLED=1

# Issuer — KEYCLOAK_TOKEN_URI and KEYCLOAK_JWKS_URI are derived from this
# when not set explicitly.
KEYCLOAK_ISSUER=http://keycloak:8080/realms/zt
KEYCLOAK_TOKEN_URI=
KEYCLOAK_JWKS_URI=

# Per-service client credentials (must exist as clients in the realm with
# Client Credentials grant enabled and Service Accounts turned on).
KEYCLOAK_CLIENT_ID=gateway
KEYCLOAK_CLIENT_SECRET=

# Downstream audience mapping — client_ids to request on outgoing tokens.
# Matches the clients seeded by docker/keycloak/realm-zt.json.
KEYCLOAK_AUDIENCE_ORDER=order-service
KEYCLOAK_AUDIENCE_PRODUCTION=production-service
KEYCLOAK_AUDIENCE_USER=user-service

# Token / JWKS cache tuning
KEYCLOAK_SHM_DIR=/tmp/keycloak-shared
KEYCLOAK_TOKEN_REFRESH_SKEW=30
KEYCLOAK_JWKS_REFRESH_INTERVAL=300
KEYCLOAK_STALE_THRESHOLD_SECS=900

# Watcher health endpoint (optional; set empty string to disable)
KEYCLOAK_WATCHER_HEALTH_ADDR=127.0.0.1:9901

# ------------------------------------------------------------------------------
# EventStoreDB (event persistence — HTTP API)
# ------------------------------------------------------------------------------
EVENTSTOREDB_ENABLED=1
EVENTSTOREDB_HOST=eventstoredb
EVENTSTOREDB_PORT=2113

# ------------------------------------------------------------------------------
# E2E / CI knobs (scripts/e2e-gateway.sh, scripts/ci-verify.sh)
# ------------------------------------------------------------------------------
# requeue | consume
E2E_QUEUE_CHECK_MODE=requeue
# none | full
E2E_DIAG_LEVEL=full
# 1 = keep containers on failure for debugging
E2E_KEEP_ON_FAIL=0
E2E_BUILD_IMAGES=1
E2E_WAIT_TIMEOUT=60
# Number of E2E iterations in `composer ci:verify` (default 20 in script)
E2E_RUNS=1
CI_PREBUILD_IMAGES=1
