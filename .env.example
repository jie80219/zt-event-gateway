# ==============================================================================
# zt-event-gateway — environment variables
# Copy this file to `.env` and adjust for your environment.
# Loaded via vlucas/phpdotenv where applicable; all runtime reads use getenv().
# ==============================================================================

# ------------------------------------------------------------------------------
# Gateway (bin/gateway.php — OpenSwoole HTTP server)
# ------------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_WORKERS=2

# ------------------------------------------------------------------------------
# RabbitMQ — worker.php uses AMQP_*, legacy RabbitMQConnection uses RABBITMQ_*.
# Keep both in sync until the naming is consolidated.
# ------------------------------------------------------------------------------
AMQP_HOST=rabbitmq
AMQP_PORT=5672
AMQP_USER=zt
AMQP_PASSWORD=ztpass
AMQP_EXCHANGE=events
AMQP_EXCHANGE_TYPE=direct
REQUEST_QUEUE=order_queue
REQUEST_ROUTING_KEY=request.new

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=zt
RABBITMQ_PASS=ztpass

# ------------------------------------------------------------------------------
# SPIFFE master toggle
#
# Set to 0 to run the stack without any SPIFFE/SPIRE/LSVID/mTLS layer.
# When SPIFFE_ENABLED=0:
#   - the three sub-flags below are force-disabled in gateway + worker
#   - the SPIRE stack (server/agent/workload-registrar/spiffe-watcher)
#     stays dormant because those services sit behind the compose
#     profile `zt` — activate with `COMPOSE_PROFILES=zt docker compose up`
#
# Ablation combinations (see docs/experiment-comparison-targets.md):
#   Baseline:    SPIFFE_ENABLED=0
#   LSVID only:  SPIFFE_ENABLED=1 LSVID_ENABLED=1 SPIFFE_MTLS_ENABLED=0
#   mTLS only:   SPIFFE_ENABLED=1 LSVID_ENABLED=0 SPIFFE_MTLS_ENABLED=1
#   Full ZT:     SPIFFE_ENABLED=1 LSVID_ENABLED=1 SPIFFE_MTLS_ENABLED=1
# ------------------------------------------------------------------------------
SPIFFE_ENABLED=1

# ------------------------------------------------------------------------------
# SPIFFE / SPIRE identity (trust domain: zt.local)
# SPIFFE_ENDPOINT_SOCKET points at the local SPIRE Agent UDS.
# ------------------------------------------------------------------------------
SPIFFE_ID=spiffe://zt.local/php-gateway
SPIFFE_ENDPOINT_SOCKET=unix:/run/spire/sockets/agent.sock

# ------------------------------------------------------------------------------
# SPIFFE watcher (bin/spiffe-watcher.php) — optional tuning
# ------------------------------------------------------------------------------
# Directory to write rotated SVID PEM files (leave empty to disable PEM output)
SPIFFE_PEM_DIR=
# Max reconnect attempts to SPIRE Agent (0 = unlimited)
SPIFFE_MAX_RETRIES=0
SPIFFE_BACKOFF_INITIAL=1
SPIFFE_BACKOFF_MAX=30
SPIFFE_CONNECT_TIMEOUT=5
# Validate SVIDs on every rotation (1 = on, 0 = off)
SPIFFE_VALIDATE=1

# ------------------------------------------------------------------------------
# EventStoreDB (event persistence — HTTP API)
# ------------------------------------------------------------------------------
EVENTSTOREDB_ENABLED=1
EVENTSTOREDB_HOST=eventstoredb
EVENTSTOREDB_PORT=2113

# ------------------------------------------------------------------------------
# E2E / CI knobs (scripts/e2e-gateway.sh, scripts/ci-verify.sh)
# ------------------------------------------------------------------------------
# requeue | consume
E2E_QUEUE_CHECK_MODE=requeue
# none | full
E2E_DIAG_LEVEL=full
# 1 = keep containers on failure for debugging
E2E_KEEP_ON_FAIL=0
E2E_BUILD_IMAGES=1
E2E_WAIT_TIMEOUT=60
# Number of E2E iterations in `composer ci:verify` (default 20 in script)
E2E_RUNS=1
CI_PREBUILD_IMAGES=1

# ------------------------------------------------------------------------------
# Thesis experiment (scripts/run-thesis-experiment.sh,
#                    scripts/collect-experiment-data.sh Stage 5b)
# LSVID_CAPTURE_DEBUG=1 makes downstream services append each received X-LSVID
# (size + raw token) to /tmp/lsvid-capture.log inside the container. Used only
# during size-measurement probes; leave unset in production.
# ------------------------------------------------------------------------------
LSVID_CAPTURE_DEBUG=0
