# ==============================================================================
# zt-event-gateway — environment variables
# Copy this file to `.env` and adjust for your environment.
# Loaded via vlucas/phpdotenv where applicable; all runtime reads use getenv().
# ==============================================================================

# ------------------------------------------------------------------------------
# Gateway (bin/gateway.php — OpenSwoole HTTP server)
# ------------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_WORKERS=2

# ------------------------------------------------------------------------------
# RabbitMQ — worker.php uses AMQP_*, legacy RabbitMQConnection uses RABBITMQ_*.
# Keep both in sync until the naming is consolidated.
# ------------------------------------------------------------------------------
AMQP_HOST=rabbitmq
AMQP_PORT=5672
AMQP_USER=zt
AMQP_PASSWORD=ztpass
AMQP_EXCHANGE=events
AMQP_EXCHANGE_TYPE=direct
REQUEST_QUEUE=order_queue
REQUEST_ROUTING_KEY=request.new

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=zt
RABBITMQ_PASS=ztpass

# ------------------------------------------------------------------------------
# EventStoreDB (event persistence — HTTP API)
# ------------------------------------------------------------------------------
EVENTSTOREDB_ENABLED=1
EVENTSTOREDB_HOST=eventstoredb
EVENTSTOREDB_PORT=2113

# ------------------------------------------------------------------------------
# Downstream services (called from worker.php Saga handlers)
# Direct mode (default): point at the actual service hosts.
# Mesh mode (Phase 1+):  set *_SERVICE_HOST=linkerd, *_SERVICE_PORT=4140 and
#                        enable LINKERD_ENABLED=1 (auto-set by the linkerd
#                        compose overlay — see docker-compose.linkerd.yml).
# ------------------------------------------------------------------------------
ORDER_SERVICE_HOST=10.1.1.210
ORDER_SERVICE_PORT=8082
PRODUCTION_SERVICE_HOST=10.1.1.207
PRODUCTION_SERVICE_PORT=8083
USER_SERVICE_HOST=10.1.1.214
USER_SERVICE_PORT=8084

# ------------------------------------------------------------------------------
# Linkerd 1.x mesh (off by default; activated via docker-compose.linkerd.yml).
# When LINKERD_ENABLED=1 the LinkerdHostHeaderFilter overrides the outbound
# Host header to the logical service name so the mesh can route via dtab.
# ------------------------------------------------------------------------------
LINKERD_ENABLED=0
LINKERD_HOST=linkerd
LINKERD_PORT=4140

# ------------------------------------------------------------------------------
# E2E / CI knobs (scripts/e2e-gateway.sh, scripts/ci-verify.sh)
# ------------------------------------------------------------------------------
# requeue | consume
E2E_QUEUE_CHECK_MODE=requeue
# none | full
E2E_DIAG_LEVEL=full
# 1 = keep containers on failure for debugging
E2E_KEEP_ON_FAIL=0
E2E_BUILD_IMAGES=1
E2E_WAIT_TIMEOUT=60
# Number of E2E iterations in `composer ci:verify` (default 20 in script)
E2E_RUNS=1
CI_PREBUILD_IMAGES=1
