{
  "name": "zt/event-gateway",
  "description": "PHP event-driven gateway with SPIFFE/SPIRE + optional Keycloak (OAuth2) layer",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "php-amqplib/php-amqplib": "^3.7.4",
    "ramsey/uuid": "^4.7",
    "nikic/fast-route": "^1.3",
    "guzzlehttp/guzzle": "^7.0",
    "monolog/monolog": "^3.4",
    "vlucas/phpdotenv": "^5.5",
    "mikey179/vfsstream": "^1.6",
    "sdpmlab/anser-action": "^0.3.10",
    "sdpmlab/anser": "^0.2.6",
    "prooph/event-store": "^7.9",
    "prooph/pdo-event-store": "^1.15",
    "sdpmlab/php-spiffe": "^1.0@dev",
    "firebase/php-jwt": "^6.10",
    "workerman/workerman": "^4.1 || ^5.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.17",
    "phpunit/phpunit": "^10.5",
    "openswoole/ide-helper": "^4.11"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/php-spiffe",
      "options": {
        "symlink": true
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "",
      "App\\Controllers\\": "anser-gateway/app/HTTP/Controllers/",
      "AnserGateway\\": "anser-gateway/system/",
      "Config\\": "anser-gateway/config/",
      "ZtEventGateway\\": "src/",
      "SDPMlab\\ZtEventGateway\\": "src/",
      "App\\Events\\": "Event-Driven/Events/",
      "App\\Sagas\\": "Sagas/",
      "Filters\\": "anser-gateway/Filters/",
      "Services\\": "Services/",
      "Spiffe\\": "src/Spiffe/",
      "GPBMetadata\\": "src/GPBMetadata/",
      "Keycloak\\": "src/Keycloak/"
    }
  },
  "scripts": {
    "gateway": "php -S 0.0.0.0:8081 -t public",
    "worker": "php bin/worker.php",
    "app:init": "php init.php",
    "consumer": "php consumer.php OrderCreateRequestedEvent",
    "publish": "php publisher.php",
    "test:unit": "vendor/bin/phpunit -c phpunit.xml",
    "test:failure-modes": "bash scripts/e2e-failure-modes.sh",
    "spiffe:e2e": "bash spiffe/e2e/run-e2e.sh",
    "gateway:e2e": "bash scripts/e2e-gateway.sh",
    "arch:e2e": "bash scripts/e2e-full-architecture.sh",
    "experiment": "bash scripts/collect-experiment-data.sh",
    "experiment:micro": "bash scripts/collect-experiment-data.sh --micro-only",
    "ci:verify": "bash scripts/ci-verify.sh",
    "ci:zt": "CI_MODE=full CI_PROFILE=zt COMPOSE_PROFILES=zt bash scripts/ci-verify.sh",
    "ci:baseline": "CI_MODE=baseline SPIFFE_ENABLED=0 KEYCLOAK_ENABLED=0 bash scripts/ci-verify.sh",
    "ci:keycloak": "CI_MODE=full CI_PROFILE=keycloak COMPOSE_PROFILES=keycloak bash scripts/ci-verify.sh",
    "spiffe:verify": "bash scripts/verify-spire-integrity.sh",
    "spiffe:split": "bash packages/php-spiffe/split.sh",
    "security:suite": "bash scripts/security-suite/run-security-suite.sh",
    "security:unit": "SEC_SKIP_HTTP=1 SEC_SKIP_AMQP=1 SEC_SKIP_ROTATE=1 SEC_SKIP_DOCKER=1 bash scripts/security-suite/run-security-suite.sh",
    "security:plot": "bash -c 'LATEST=$(ls -dt artifacts/security-* 2>/dev/null | head -1); [[ -z \"$LATEST\" ]] && echo \"no artifacts/security-* found\" && exit 1; python3 scripts/security-suite/plot/plot_security.py \"$LATEST\"'"
  }
}
